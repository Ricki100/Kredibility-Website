Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www (optional — delete these 2 lines if you want www)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Redirect /index or /index.html to root /
RewriteCond %{THE_REQUEST} /index(\.html)?\s [NC]
RewriteRule ^index(\.html)?$ / [L,R=301]

# Redirect any .html request to clean URL (e.g. /about.html → /about)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html [NC]
RewriteRule ^(.+)\.html$ /$1 [L,R=301]

# Serve .html file when clean URL is requested (e.g. /about → about.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Custom error pages (optional)
ErrorDocument 404 /404.html
